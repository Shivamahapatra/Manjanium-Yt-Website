{
  "name": "manjanium-monorepo",
  "private": true,
  "scripts": {
    "dev:hub": "pnpm --filter hub dev",
    "dev:game": "pnpm --filter game dev",
    "dev:telemetry": "cd apps/telemetry && .venv\\Scripts\\python main.py",
    "dev:telemetry:mac": "cd apps/telemetry && .venv/bin/python main.py",
    "build:hub": "pnpm --filter hub build",
    "build:game": "pnpm --filter game build",
    "build": "pnpm --filter hub build && pnpm --filter game build",
    "lint": "pnpm --filter hub lint && pnpm --filter game lint"
  },
  "packageManager": "pnpm@9.0.0",
  "resolutions": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0"
  },
  "overrides": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0"
  }
}
