# API-Football API Key (obtain free key from https://dashboard.api-football.com/ or RapidAPI)
API_FOOTBALL_KEY=your_api_key_here

# (Optional) RapidAPI key if using RapidAPI endpoint
# RAPIDAPI_KEY=

# (Optional) Football-Data.org API Key
# FOOTBALL_DATA_ORG_KEY=

# (Optional) FastF1 cache directory
# FASTF1_CACHE_DIR=
